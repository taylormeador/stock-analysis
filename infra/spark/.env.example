# Copy to .env on each node and edit for that node's role.
# .env is gitignored — this file is the template, not the real config.

# SPARK_LOCAL_IP: this node's own real LAN IP (required on both master and
# worker — used so Spark advertises a reachable address, not a container-
# internal hostname that the other node can't resolve).

# --- Master node ---
# SPARK_MODE=master
# SPARK_LOCAL_IP=<this-node-ip>

# --- Worker node(s) ---
# SPARK_MODE=worker
# SPARK_LOCAL_IP=<this-node-ip>
# SPARK_MASTER_URL=spark://<master-node-ip>:7077
